# Site Configuration
NEXT_PUBLIC_SITE_URL=https://drpedrofelipe.com.br

# Força dados locais (true = não consulta Supabase nas páginas públicas)
# USE_LOCAL_DATA=true

# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Aliases opcionais (se usar @supabase/server)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-secret-key-here

# Vercel Blob (para upload de imagens)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxx

# Cron do calendário editorial (publicação automática)
# Gere com: openssl rand -base64 32
# Na Vercel, o Cron envia Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your-cron-secret-here

# Google Analytics (optional — legado; o site usa Vercel Analytics + site_events no Supabase)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Analytics interno: tabela site_events no Supabase + @vercel/analytics no layout
# Ative Web Analytics no projeto da Vercel para o painel detalhado na Vercel.

# Email Service (optional - for contact form)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Google Maps API (optional - for location map)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaxxxxxxxxxx

# Assistente de artigo no admin = copiar/colar no Claude ou Gemini Pro (chat).
# Não precisa de ANTHROPIC_API_KEY nem GEMINI_API_KEY.
